---
import type { BriefingItem, CATEGORIES } from '../lib/types';
import ItemCard from './ItemCard.astro';

interface Props {
  category: (typeof CATEGORIES)[number];
  items: BriefingItem[];
  /** Set the first item as the day's lede. */
  leadFirst?: boolean;
}

const { category, items, leadFirst = false } = Astro.props;
const warning = category.tone === 'warning';
---

<section
  id={category.id}
  class:list={['scroll-mt-6 border-t-[3px] pt-3', warning ? 'border-accent' : 'border-ink']}
  aria-labelledby={`heading-${category.id}`}
>
  <h2 id={`heading-${category.id}`} class:list={['flex items-baseline gap-2 text-base font-bold', warning && 'text-accent']}>
    {category.label}
    <span class="font-normal tabular-nums text-muted">{items.length}</span>
  </h2>
  <ol class="divide-y divide-rule">
    {items.map((item, i) => <ItemCard item={item} lead={leadFirst && i === 0} />)}
  </ol>
</section>
