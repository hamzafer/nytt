---
import { getUpcomingKeyDates } from '../lib/data';
import { dayOfMonth, shortMonth, relativeDays } from '../lib/dates';

interface Props {
  todayIso: string;
}

const { todayIso } = Astro.props;
const dates = getUpcomingKeyDates(todayIso).slice(0, 6);
---

<aside aria-labelledby="key-dates-heading" class="border-t-[3px] border-ink pt-3">
  <h2 id="key-dates-heading" class="text-base font-bold">Coming up</h2>
  {
    dates.length === 0 ? (
      <p class="mt-3 text-sm text-muted">No deadlines on the calendar right now.</p>
    ) : (
      <ol class="divide-y divide-rule">
        {dates.map((d) => (
          <li class="grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-3 py-3.5">
            <time datetime={d.date} class="text-center leading-none">
              <span class="block text-[1.75rem] font-extrabold tabular-nums tracking-[-0.03em]">{dayOfMonth(d.date)}</span>
              <span class="mt-1 block text-xs font-medium text-muted">{shortMonth(d.date)}</span>
            </time>
            <div class="min-w-0">
              <p class="font-medium leading-snug">{d.label}</p>
              <p class="mt-0.5 text-sm text-muted">
                {relativeDays(todayIso, d.date)}
                {d.detail && <>. {d.detail}</>}
              </p>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</aside>
