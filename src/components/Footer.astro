---
import { nyttConfig } from '../../nytt.config';
import { withBase } from '../lib/data';

const base = import.meta.env.BASE_URL;
const error = nyttConfig.reportError;
const external = error.type === 'github' ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto grid max-w-5xl gap-4 px-5 py-10 text-sm text-muted">
    <p class="max-w-[60ch] leading-relaxed">
      {nyttConfig.name} is an unofficial daily summary for internationals in Norway, written in our own words. It isn't
      affiliated with NRK, VG or any other publisher. Read the original source before you act on anything here.
    </p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={error.href} class="prose-link text-ink" {...external}>{error.label}</a>
      <a href={withBase('/feed.xml', base)} class="prose-link text-ink">RSS feed</a>
    </p>
  </div>
</footer>
