---
import { nyttConfig } from '../../nytt.config';
import { withBase } from '../lib/data';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: withBase('/', base), label: 'Today', match: (p: string) => p === withBase('/', base) },
  { href: withBase('/archive/', base), label: 'Archive', match: (p: string) => p.includes('/archive/') || p.includes('/day/') },
  { href: withBase('/search/', base), label: 'Search', match: (p: string) => p.includes('/search/') },
];
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3">
    <a href={withBase('/', base)} class="flex items-baseline gap-3">
      <span class="text-2xl font-black tracking-[-0.04em]">{nyttConfig.name}</span>
      <span class="hidden text-sm text-muted md:inline">{nyttConfig.tagline}</span>
    </a>
    <nav class="flex items-center gap-1 text-[0.9375rem]" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.match(path) ? 'page' : undefined}
            class="px-2.5 py-2 font-medium text-muted transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
          >
            {l.label}
          </a>
        ))
      }
      <button
        type="button"
        id="theme-toggle"
        aria-pressed="false"
        class="ml-1 grid size-9 place-items-center text-muted transition-colors hover:text-ink"
      >
        <span class="sr-only">Dark mode</span>
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
