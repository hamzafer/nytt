---
import type { BriefingItem } from '../lib/types';

interface Props {
  item: BriefingItem;
  /** The first item of the day, set larger as the lede. */
  lead?: boolean;
}

const { item, lead = false } = Astro.props;
---

<li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-3 py-5" data-item>
  <span class:list={['leading-none', lead ? 'pt-1.5 text-2xl' : 'pt-1 text-xl']} aria-hidden="true">{item.emoji}</span>
  <div class="min-w-0 max-w-[64ch]">
    <p
      class:list={[lead ? 'text-[1.375rem] font-medium leading-snug tracking-[-0.01em] sm:text-2xl' : 'text-[1.0625rem] leading-relaxed']}
      data-glossary-text
    >
      {item.text}
    </p>
    {
      item.takeaway && (
        <p class="mt-3 border-l-2 border-ink pl-3 text-[0.9375rem] leading-relaxed">
          <strong class="font-semibold">For you:</strong> {item.takeaway}
        </p>
      )
    }
    {
      item.correction && (
        <p class="mt-3 border-l-2 border-accent pl-3 text-[0.9375rem] leading-relaxed">
          <strong class="font-semibold text-accent">Correction:</strong> {item.correction}
        </p>
      )
    }
    <p class="mt-2 text-sm text-muted">
      {item.sources.length > 1 ? 'Sources' : 'Source'}:{' '}
      {
        item.sources.map((src, i) => (
          <>
            {i > 0 && ', '}
            <a href={src.url} target="_blank" rel="noopener noreferrer" class="prose-link text-ink">
              {src.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
</li>
