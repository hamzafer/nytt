---
import type { BriefingItem, CategoryId } from '../lib/types';

interface Props {
  item: BriefingItem;
  categoryId: CategoryId;
}

const { item, categoryId } = Astro.props;
---

<article
  class="group rounded-2xl border border-fjord-200/80 bg-white/80 p-4 shadow-sm backdrop-blur-sm transition hover:border-fjord-400/50 hover:shadow-md dark:border-fjord-800/80 dark:bg-fjord-950/40"
  data-item
  data-category={categoryId}
>
  <div class="flex gap-3">
    <span class="text-2xl leading-none" aria-hidden="true">{item.emoji}</span>
    <div class="min-w-0 flex-1 space-y-3">
      <p class="glossary-host text-[0.95rem] leading-relaxed text-[var(--color-ink)]" data-glossary-text>
        {item.text}
      </p>
      {
        item.takeaway && (
          <p class="rounded-lg border-l-4 border-mint-500 bg-mint-500/10 px-3 py-2 text-sm text-fjord-800 dark:text-fjord-100">
            <span class="font-semibold">What this means for you:</span> {item.takeaway}
          </p>
        )
      }
      {
        item.correction && (
          <p class="rounded-lg border-l-4 border-amber-500 bg-amber-500/15 px-3 py-2 text-sm">
            <span class="font-semibold">Correction:</span> {item.correction}
          </p>
        )
      }
      <ul class="flex flex-wrap gap-2 pt-1">
        {
          item.sources.map((src) => (
            <li>
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-full bg-fjord-100 px-3 py-1 text-xs font-medium text-fjord-800 transition hover:bg-fjord-200 dark:bg-fjord-800 dark:text-fjord-100 dark:hover:bg-fjord-600"
              >
                {src.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>