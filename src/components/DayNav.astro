---
import { getAdjacentDates } from '../lib/briefings';
import { formatLongDate } from '../lib/dates';
import { withBase } from '../lib/data';

interface Props {
  date: string;
}

const { date } = Astro.props;
const { prev, next } = getAdjacentDates(date);
const base = import.meta.env.BASE_URL;
const links = [
  prev && { iso: prev, label: 'Previous day', align: '' },
  next && { iso: next, label: 'Next day', align: 'sm:text-right sm:col-start-2' },
].filter(Boolean) as { iso: string; label: string; align: string }[];
---

<nav class="mx-auto mt-16 max-w-5xl px-5" aria-label="Briefing days">
  <div class="grid gap-6 border-t border-rule pt-6 sm:grid-cols-2">
    {
      links.map((l) => (
        <a href={withBase(`/day/${l.iso}/`, base)} class:list={['group block', l.align]}>
          <span class="block text-sm text-muted">{l.label}</span>
          <span class="mt-0.5 block text-lg font-semibold group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
            {formatLongDate(l.iso)}
          </span>
        </a>
      ))
    }
  </div>
</nav>
