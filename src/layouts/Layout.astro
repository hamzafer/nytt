---
import '../styles/global.css';
import { nyttConfig } from '../../nytt.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGlossary, withBase } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = nyttConfig.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${nyttConfig.name}` : `${nyttConfig.name}: ${nyttConfig.tagline}`;
const glossary = getGlossary();
const base = import.meta.env.BASE_URL;
const searchIndexUrl = withBase('/search-index.json', base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1626" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${nyttConfig.name} RSS`} href={withBase('/feed.xml', base)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // Set the theme before first paint so dark mode never flashes light.
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('nytt-theme');
        } catch (e) {}
        var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
    {
      nyttConfig.analytics.enabled && nyttConfig.analytics.scriptUrl && (
        <script defer data-domain={nyttConfig.analytics.domain} src={nyttConfig.analytics.scriptUrl} />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script type="application/json" id="glossary-data" set:html={JSON.stringify(glossary)} />
    <script type="application/json" id="site-base" set:html={JSON.stringify(base)} />
    <script is:inline src={`${base}scripts/site.js`}></script>
    <script define:vars={{ searchIndexUrl }}>
      window.__NYTT_SEARCH_INDEX_URL__ = searchIndexUrl;
    </script>
  </body>
</html>
