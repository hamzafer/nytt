---
import Layout from '../layouts/Layout.astro';
import BriefingView from '../components/BriefingView.astro';
import DayNav from '../components/DayNav.astro';
import { getLatestBriefing } from '../lib/briefings';
import { formatLongDate } from '../lib/dates';

const briefing = getLatestBriefing();
---

<Layout title={`Today, ${formatLongDate(briefing.date)}`} description={briefing.intro ?? briefing.title}>
  <BriefingView briefing={briefing} />
  <DayNav date={briefing.date} />
</Layout>
