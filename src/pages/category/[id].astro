---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, type CategoryId } from '../../lib/types';
import { getItemsByCategory, getCategoryMeta } from '../../lib/briefings';
import { formatLongDate } from '../../lib/dates';
import { withBase } from '../../lib/data';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const meta = getCategoryMeta(id as CategoryId);
const items = getItemsByCategory(meta.id).reverse();
const base = import.meta.env.BASE_URL;
const warning = meta.tone === 'warning';
---

<Layout title={meta.label} description={`Every ${meta.label} story across all briefings`}>
  <div class="mx-auto max-w-3xl px-5 pt-10 sm:pt-14">
    <h1 class:list={['text-5xl font-black tracking-[-0.045em] sm:text-6xl', warning && 'text-accent']}>{meta.label}</h1>
    <p class="mt-3 text-lg text-muted">{items.length} stories across every briefing, newest first.</p>
    <ol id="category-items" class:list={['mt-10 divide-y divide-rule border-t-[3px] pt-1', warning ? 'border-accent' : 'border-ink']}>
      {
        items.map((row) => (
          <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-3 py-5">
            <span class="pt-1 text-xl leading-none" aria-hidden="true">{row.emoji}</span>
            <div class="min-w-0 max-w-[64ch]">
              <a href={withBase(`/day/${row.date}/`, base)} class="prose-link text-sm font-medium text-muted">
                <time datetime={row.date}>{formatLongDate(row.date)}</time>
              </a>
              <p class="mt-1 text-[1.0625rem] leading-relaxed" data-glossary-text>{row.text}</p>
              <p class="mt-2 text-sm text-muted">
                {row.sources.length > 1 ? 'Sources' : 'Source'}:{' '}
                {row.sources.map((src, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={src.url} target="_blank" rel="noopener noreferrer" class="prose-link text-ink">{src.label}</a>
                  </>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Layout>
