---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, type CategoryId } from '../../lib/types';
import { getItemsByCategory, formatBriefingDate, getCategoryMeta } from '../../lib/briefings';
import { withBase } from '../../lib/data';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const categoryId = id as CategoryId;
const meta = getCategoryMeta(categoryId);
const items = getItemsByCategory(categoryId).reverse();
const base = import.meta.env.BASE_URL;
---

<Layout title={meta.label} description={`All ${meta.label} items across every briefing`}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display text-3xl font-bold">
      <span aria-hidden="true">{meta.emoji}</span> {meta.label}
    </h1>
    <p class="mt-2 text-fjord-700 dark:text-fjord-200">{items.length} items across all published days.</p>
    <ul id="category-items" class="mt-8 space-y-4">
      {
        items.map((row) => (
          <li data-category-item class="rounded-2xl border border-fjord-200 bg-white/80 p-4 dark:border-fjord-800 dark:bg-fjord-950/40">
            <p class="text-xs font-semibold uppercase text-coral-600">{formatBriefingDate(row.date)}</p>
            <p class="mt-2 glossary-host text-[0.95rem] leading-relaxed" data-glossary-text>
              {row.emoji} {row.text}
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {row.sources.map((src) => (
                <li>
                  <a
                    href={src.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-medium text-fjord-700 underline dark:text-fjord-200"
                  >
                    {src.label} ↗
                  </a>
                </li>
              ))}
            </ul>
            <a href={withBase(`/day/${row.date}/`, base)} class="mt-2 inline-block text-sm font-medium text-coral-600">
              Full day →
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>