---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search" description="Search every briefing">
  <div class="mx-auto max-w-3xl px-5 pt-10 sm:pt-14">
    <h1 class="text-5xl font-black tracking-[-0.045em] sm:text-6xl">Search</h1>
    <p class="mt-3 text-lg text-muted">Search every story since the first briefing. It runs in your browser, nothing is tracked.</p>
    <label class="mt-8 block">
      <span class="sr-only">Search stories</span>
      <input
        id="search-input"
        type="search"
        name="q"
        autocomplete="off"
        placeholder="Try Norgespris, T-bane or Equinor"
        class="w-full border-0 border-b-[3px] border-ink bg-transparent px-0 py-3 text-2xl font-medium placeholder:text-muted focus:border-focus focus:outline-none focus:ring-0"
      />
    </label>
    <p id="search-status" class="mt-3 min-h-[1.25rem] text-sm text-muted" role="status"></p>
    <ol id="search-results" class="mt-2 divide-y divide-rule"></ol>
  </div>
</Layout>
