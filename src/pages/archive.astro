---
import Layout from '../layouts/Layout.astro';
import { getAllBriefings, getFilledSections } from '../lib/briefings';
import { formatLongDate, monthYear, norwegianWeekday } from '../lib/dates';
import { withBase } from '../lib/data';
import { CATEGORIES } from '../lib/types';

const base = import.meta.env.BASE_URL;
const rows = [...getAllBriefings()].reverse().map((b) => {
  const sections = getFilledSections(b);
  return {
    briefing: b,
    count: sections.reduce((n, s) => n + s.items.length, 0),
    lede: b.title ?? sections[0]?.items[0]?.text ?? '',
  };
});
const months = Map.groupBy(rows, (r) => monthYear(r.briefing.date));
---

<Layout title="Archive" description="Every morning briefing, newest first">
  <div class="mx-auto max-w-3xl px-5 pt-10 sm:pt-14">
    <h1 class="text-5xl font-black tracking-[-0.045em] sm:text-6xl">Archive</h1>
    <p class="mt-3 text-lg text-muted">Every morning briefing, newest first.</p>
    <nav aria-label="Browse by section" class="mt-6 text-[0.9375rem]">
      <p class="text-muted">Or browse one section across every day:</p>
      <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1.5">
        {CATEGORIES.map((c) => (
          <li>
            <a href={withBase(`/category/${c.id}/`, base)} class="prose-link font-medium">{c.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {
      [...months].map(([month, list]) => (
        <section class="mt-12 border-t-[3px] border-ink pt-3" aria-label={month}>
          <h2 class="text-base font-bold">{month}</h2>
          <ol class="divide-y divide-rule">
            {list.map(({ briefing, count, lede }) => (
              <li>
                <a href={withBase(`/day/${briefing.date}/`, base)} class="group grid gap-1 py-4 sm:grid-cols-[11.5rem_minmax(0,1fr)] sm:gap-6">
                  <span>
                    <span lang="nb" class="block text-xl font-extrabold tracking-[-0.03em] group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
                      {norwegianWeekday(briefing.date)}
                    </span>
                    <time datetime={briefing.date} class="block text-sm text-muted">
                      {formatLongDate(briefing.date).replace(/ \d{4}$/, '')}
                    </time>
                  </span>
                  <span class="min-w-0">
                    <span class="line-clamp-2 leading-relaxed">{lede}</span>
                    <span class="mt-1 block text-sm text-muted">{count} {count === 1 ? 'story' : 'stories'}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Layout>
